# notion-listen settings, stored at ~/.config/notion-listen/config.env.
# `notion-listen setup` fills these in for you. To change them, re-run it or edit
# the file, then restart the session.

# Integration secret from https://www.notion.so/profile/integrations
NOTION_TOKEN=

# Notion user ids (comma-separated) whose comments the agent acts on.
# Empty = anyone who can comment on the page can instruct the agent.
NOTION_ALLOWED_AUTHORS=

# Free static domain from https://dashboard.ngrok.com/domains, e.g.
# my-name.ngrok-free.app. Empty = a new random URL every run.
NGROK_DOMAIN=

# Local port for the webhook listener.
NOTION_LISTEN_PORT=8788

# Written automatically when Notion verifies the webhook. To verify a new
# subscription, run `notion-listen setup` again.
NOTION_VERIFICATION_TOKEN=

# --- Optional: emoji status reactions (👀 picked up, 🤔 working, ✅ done) ------
# Without these, the agent posts short text status replies instead.
# The public Notion API has no reactions endpoint, so this uses Notion's
# unofficial web API with your browser session cookie. token_v2 is a
# FULL-ACCESS credential for your whole account, and the endpoint may break
# without notice. Find all three in your browser's dev tools on notion.so:
# the token_v2 cookie, and spaceId / your user id from any API request.
NOTION_TOKEN_V2=
NOTION_SPACE_ID=
NOTION_ACTOR_ID=
